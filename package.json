{
  "name": "clara-financas",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:agent": "turbo run dev -F @clara-financas/agent",
    "db:push": "turbo run db:push -F @clara-financas/db",
    "db:studio": "turbo run db:studio -F @clara-financas/db",
    "db:generate": "turbo run db:generate -F @clara-financas/db",
    "db:migrate": "turbo run db:migrate -F @clara-financas/db",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry",
    "test": "turbo run test",
    "test:isolation": "turbo run test:isolation -F @clara-financas/db"
  },
  "dependencies": {
    "@clara-financas/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clara-financas/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "^4.22.5",
    "turbo": "^2.10.2",
    "typescript": "catalog:",
    "vercel": "^54.18.6"
  },
  "packageManager": "pnpm@10.20.0"
}
