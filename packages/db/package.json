{
  "name": "@clara-financas/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "check-types": "tsc --noEmit",
    "test": "SKIP_ENV_VALIDATION=1 node --import tsx --env-file=../../apps/web/.env --test src/isolation.test.ts",
    "test:isolation": "SKIP_ENV_VALIDATION=1 node --import tsx --env-file=../../apps/web/.env --test src/isolation.test.ts"
  },
  "dependencies": {
    "@clara-financas/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.7",
    "zod": "catalog:",
    "@clara-financas/okf": "workspace:*"
  },
  "devDependencies": {
    "@clara-financas/config": "workspace:*",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "tsx": "^4.22.5"
  }
}
