{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        // Herdado do scaffold, `dist/**` não é a saída de nenhum pacote deste
        // repositório — o Turbo avisava "no output files found" a cada build e
        // o cache guardava vazio, ou seja, todo build era do zero.
        ".next/**",
        "!.next/cache/**",
        // O eve emite `.output` no build local e `.vercel/output` quando roda
        // dentro de um build hospedado (ele detecta a variável VERCEL).
        ".output/**",
        ".vercel/output/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:isolation": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:local": {
      "cache": false
    }
  }
}
